# Assisted Profile pilot deployment — example environment.
#
# Copy to .env in this directory and fill in real values before running
# `docker compose up`. Never commit the resulting .env file (it holds a real
# secret key) — see certificates/README.md for the TLS material, which is
# equally sensitive and equally must not be committed.

# ---------------------------------------------------------------------------
# fwcloud-ai-agent image (AG-6). Never "latest" — pin an explicit version or
# digest produced by that repo's own build/release process.
# ---------------------------------------------------------------------------
FWCLOUD_AI_AGENT_IMAGE=fwcloud-ai-agent
FWCLOUD_AI_AGENT_VERSION=<version-or-digest>

# ---------------------------------------------------------------------------
# Ollama (AG-6). Must match the version pinned by the agent's own model
# manifest (config/models/assisted-profile-model.yaml inside the agent
# image) — currently 0.30.8. Do not bump this independently of that manifest.
# ---------------------------------------------------------------------------
OLLAMA_IMAGE=ollama/ollama
OLLAMA_VERSION=0.30.8

# ---------------------------------------------------------------------------
# AG-4 inbound service authentication. This key MUST be identical to the
# fwcloud-api side's ASSISTED_PROFILE_AGENT_API_KEY (root .env.example /
# ASSISTED_PROFILE_AGENT_API_KEY convict key). Generate with e.g.:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
ASSISTED_PROFILE_AGENT_API_KEY=replace-with-a-securely-generated-value

# AG-4 source-IP allowlist for the agent (comma-separated IPs/CIDRs). The
# defaults below match this compose file's pinned subnet:
#   127.0.0.1/32     -> the agent's own baked-in container HEALTHCHECK,
#                        which calls http://127.0.0.1:8000/api/v1/health
#                        from inside the same container.
#   172.28.0.12/32    -> agent-tls-proxy, the only other component that ever
#                        talks to the agent directly. This must match
#                        agent-tls-proxy's ipv4_address in docker-compose.yml.
# Only widen this if you change the network topology below, and never set it
# to 0.0.0.0/0.
ASSISTED_PROFILE_AGENT_ALLOWED_IPS=127.0.0.1/32,172.28.0.12/32

# ---------------------------------------------------------------------------
# agent-tls-proxy publish binding. Loopback-only by default so only
# processes on this host (e.g. a host-run fwcloud-api) can reach the agent
# channel. Widen deliberately and prefer a firewalled interface over
# 0.0.0.0 for any multi-host pilot.
# ---------------------------------------------------------------------------
ASSISTED_PROFILE_PROXY_BIND=127.0.0.1
ASSISTED_PROFILE_PROXY_PORT=8443

# ---------------------------------------------------------------------------
# Model pin, for reference/documentation only (the actual pin lives in the
# agent image's config/models/assisted-profile-model.yaml — these values must
# match it, they do not configure it).
# ---------------------------------------------------------------------------
ASSISTED_PROFILE_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M
ASSISTED_PROFILE_MODEL_DIGEST=sha256:845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
