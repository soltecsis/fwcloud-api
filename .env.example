# Application environment.
# dev   => development
# prod  => production
NODE_ENV=dev


# CORS (Cross-Origin Resource Sharing) withelist.
CORS_WHITELIST="http://localhost"

# Secret used for session cookies and CSRF (Cros-Site Rquest Forgery) tockens.
SESSION_SECRET=

# Secret used for data encryption.
CRYPT_SECRET=

# Database connection settings
TYPEORM_CONNECTION=mysql
TYPEORM_HOST=localhost
TYPEORM_PORT=3306
TYPEORM_DATABASE=fwcloud
TYPEORM_USERNAME=
TYPEORM_PASSWORD=

# Global opt-in for the Assisted Profile feature deployment. Disabled by
# default: assistant/drafts routes 404 and the agent health poller does not
# run until this is explicitly set to true.
ASSISTED_PROFILE_ENABLED=false

# Direct Assisted Profile agent transport.
ASSISTED_PROFILE_AGENT_URL=https://fwcloud-ai-agent:8443
ASSISTED_PROFILE_AGENT_API_KEY=
ASSISTED_PROFILE_AGENT_CONNECT_TIMEOUT_MS=10000
ASSISTED_PROFILE_AGENT_READ_TIMEOUT_MS=180000
ASSISTED_PROFILE_AGENT_CA_FILE=
# Maximum waiting requests. The one active generation is counted separately.
ASSISTED_PROFILE_GENERATION_QUEUE_MAX_DEPTH=3

# Opt-in capture of ANONYMIZED proposals rejected by Assisted Profile
# validation, for later evaluation of rejection patterns. Disabled by default,
# and an absent setting behaves exactly as false. Enable it only deliberately,
# during an active pilot, after reading
# docs/assisted-profile-rejected-proposal-capture.md: it makes the API store a
# sanitized copy of rejected model output. The raw proposal, the user's
# instruction and any actor/FWCloud identity are never stored, and accepted
# proposals are never captured.
ASSISTED_PROFILE_CAPTURE_REJECTED_PROPOSALS=false
# Retention window for each captured sample. Written into the record as its
# expiration at capture time; expired samples are deleted by the purge job.
ASSISTED_PROFILE_REJECTED_PROPOSAL_RETENTION_DAYS=14
# Retention purge job. Runs even while capture is disabled, so samples from a
# finished pilot still age out.
ASSISTED_PROFILE_REJECTED_PROPOSAL_PURGE_JOB_ENABLED=true
ASSISTED_PROFILE_REJECTED_PROPOSAL_PURGE_INTERVAL_SECONDS=3600
ASSISTED_PROFILE_REJECTED_PROPOSAL_PURGE_BATCH_SIZE=500
